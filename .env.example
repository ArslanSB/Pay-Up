# Long random string, at least 16 characters. Generate: openssl rand -base64 32
SESSION_SECRET=
# Public origin of the app, no trailing slash. OAuth callbacks are built from it.
APP_URL=http://localhost:3000
# Leave a pair empty to hide that sign-in button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Shown on the Terms and Privacy pages. Required for a public deployment.
OPERATOR_NAME=
CONTACT_EMAIL=
# Optional
# Behind a reverse proxy the app must trust X-Forwarded-* headers or sign-out and other form posts fail with 400.
# Default trusts private networks (Docker, same host). "true" trusts any proxy.
TRUST_PROXY=loopback, linklocal, uniquelocal
DATABASE_PATH=./data/payup.db
APP_LOCALE=es-ES
PORT=3000
