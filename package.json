{
  "name": "pay-up",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.22.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/.bin/react-router dev",
    "build": "react-router build",
    "start": "node --env-file-if-exists=.env node_modules/.bin/react-router-serve ./build/server/index.js",
